{
    "remote.SSH.defaultExtensions": [],

    // Hints
    "C_Cpp.inlayHints.parameterNames.suppressWhenArgumentContainsName": true,
    "C_Cpp.inlayHints.autoDeclarationTypes.enabled": true,
    "C_Cpp.inlayHints.autoDeclarationTypes.showOnLeft": true,
    "C_Cpp.inlayHints.parameterNames.enabled": true,
    "C_Cpp.inlayHints.referenceOperator.enabled": true,
    "python.analysis.inlayHints.callArgumentNames": "all",

    // GitLens
    "gitlens.autolinks": [
        {
            "prefix": "SCI-",
            "url": "https://jira.cec.lab.emc.com/browse/SCI-<num>"
        },
        {
            "prefix": "PF02G-",
            "url": "https://jira.cec.lab.emc.com/browse/PF02G-<num>"
        },
        // {
        //     "prefix": "#",
        //     "alphanumeric": false,
        //     "url": "https://eos2git.cec.lab.emc.com/vxflexos/ScaleIO/pull/<num>/"
        // }
        {
            "prefix": "#",
            "alphanumeric": false,
            "url": "https://eos2git.cec.lab.emc.com/vxflexos/agentic_root_cause_analyzer/pull/<num>/"
        }
    ],
    "gitlens.hovers.currentLine.over": "line",

    // TODO Tree config:
    "todo-tree.highlights.customHighlight": {
        "BUG": {
            "icon": "bug"
        },
        "FIXME": {
            "icon": "flame"
        }
    },
    "todo-tree.highlights.useColourScheme": true,
    "todo-tree.highlights.backgroundColourScheme": [
        "green", // BUG
        "orange", // HACK
        "violet", // FIXME
        "red", // TODO
        "blue", // XXX
        "yellow",
        "indigo"
    ],
    "todo-tree.highlights.foregroundColourScheme": [
        "white", // BUG
        "black", // HACK
        "white", // FIXME
        "white", // TODO
        "white", // XXX
        "white",
        "black"
    ],
    "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",

    // IDE Config:
    "files.autoSave": "afterDelay",
    "editor.guides.bracketPairs": true,
    "remote.SSH.remotePlatform": {
        "vm_remote": "linux",
        "vm-sio-tal_afek.sio.lab.emc.com": "linux",
        "10.55.136.104": "linux",
        "vm-sio-adan_suleiman.sio.lab.emc.com": "linux",
        "vm-sio-barsha.sio.lab.emc.com": "linux",
        "vscode_bug": "linux",
        "calc1-104003": "linux"
    },
    "extensions.ignoreRecommendations": true,
    "scm.workingSets.enabled": true,
    "workbench.editor.customLabels.patterns": {
        "**/src/mdm/**": "${filename}.${extname} (MDM)",
        "**/src/gtest/mdm/**": "${filename}.${extname} (mdm_unittest)"
    },
    "workbench.editorLargeFileConfirmation": 1024,
    "editor.largeFileOptimizations": false,
    "github-enterprise.uri": "https://eos2git.cec.lab.emc.com",
    "notebook.lineNumbers": "on",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "python.autoComplete.extraPaths": [
        "/home/sio/ScaleIO_Spark2/spark2"
    ],
    "python.analysis.extraPaths": [
        "/home/sio/ScaleIO_Spark2/spark2"
    ],
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "ms-python.autopep8",
    },
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },

    // GitHub PR:
    "githubPullRequests.queries": [
        {
            "label": "Local Pull Request Branches",
            "query": "default"
        },
        {
            "label": "Waiting For My Review",
            "query": "repo:${owner}/${repository} is:open review-requested:@me"
        },
        {
            "label": "Assigned To Me",
            "query": "repo:${owner}/${repository} is:open assignee:@me"
        },
        {
            "label": "Created By Me",
            "query": "repo:${owner}/${repository} is:open author:@me"
        },
        {
            "label": "Reviewed By Me",
            "query": "repo:${owner}/${repository} is:pr is:open reviewed-by:@me"
        },
        {
            "label": "All Open",
            "query": "default"
        }
    ],

    // Enable longer repositories:
    "editor.foldingMaximumRegions": 65000,

    // Font design:
    "editor.fontFamily": "Fira Code, Consolas, 'Courier New', monospace",
    "workbench.colorTheme": "One Monokai",
    "editor.fontLigatures": true,
    "disableLigatures.mode": "Line", // "Cursor",
    "editor.bracketPairColorization.enabled": true,
    "workbench.colorCustomizations": {
        "editor.selectionBackground": "#792185",
        "editor.selectionHighlightBackground": "#eb51ff4d"
    },
    "editor.tokenColorCustomizations": {
        "comments": "#00a300"
    },

    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "terminal.integrated.defaultProfile.windows": "Command Prompt",

    "codeiumEnterprise.portalUrl": "https://codeium.delllabs.net",
    "codeium.apiServerUrl": "https://codeium.delllabs.net/_route/api_server",
    "codeiumEnterprise.extensionBaseUrl": "https://codeium.delllabs.net",
    "githubPullRequests.pullBranch": "never",
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "cSpell.userWords": [
        "agentic",
        "argmin",
        "argwhere",
        "autogen",
        "bcolors",
        "bev",
        "bevs",
        "castable",
        "catchable",
        "CHANGEME",
        "checkpointer",
        "codeium",
        "confloat",
        "conint",
        "CRITS",
        "dataframe",
        "dbfile",
        "ddls",
        "dellm",
        "DETOURABLE",
        "devs",
        "dgwt",
        "dgwts",
        "dumpfile",
        "ecpyutils",
        "EINVAL",
        "ENDC",
        "ENOENT",
        "errstate",
        "Fastlock",
        "fastmcp",
        "gnrt",
        "gtest",
        "idxmax",
        "idxmin",
        "IFNULL",
        "inodes",
        "kstest",
        "LANGFUSE",
        "lfuc",
        "mypy",
        "ndarray",
        "Noncopyable",
        "OKBLUE",
        "OKCYAN",
        "OKGREEN",
        "pfxm",
        "printoptions",
        "pvalue",
        "PYTHONDONTWRITEBYTECODE",
        "PYTHONPATH",
        "PYTHONUNBUFFERED",
        "rebuildable",
        "reconfig",
        "retrigger",
        "rqlite",
        "sdbg",
        "signum",
        "sliceidx",
        "SSHFS",
        "stdev",
        "Suspendable",
        "Tavily",
        "uber",
        "uberid",
        "Ubers",
        "Unhijack",
        "uvicorn"
    ],
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "codeium.enableConfig": {
        "*": false
    },
    "hexeditor.columnWidth": 16,
    "hexeditor.showDecodedText": true,
    "hexeditor.defaultEndianness": "little",
    "hexeditor.inspectorType": "aside",
    "editor.autoIndent": "advanced",
    "workbench.editorAssociations": {
        "{hexdiff}:/**/*.*": "hexEditor.hexedit",
        "*.csv": "gc-excelviewer-csv-editor"
    },
    "roo-cline.allowedCommands": [
        "git log",
        "git diff",
        "git show",
        "npm test",
        "npm install",
        "tsc"
    ],
    "roo-cline.deniedCommands": [],
    "security.allowedUNCHosts": [
        "W-7GNQGC4"
    ],
    // ── Zellij terminal passthrough ────────────────────────────
    // Only applies when the integrated terminal is focused.
    // All IDE shortcuts work normally when the editor is focused.
    "window.enableMenuBarMnemonics": false,
    "terminal.integrated.commandsToSkipShell": [
        "-workbench.action.gotoLine",                  // Ctrl+G → Zellij unlock/lock
        "-workbench.action.quickOpen",                  // Ctrl+P → Zellij Pane mode
        "-workbench.action.files.newUntitledFile",      // Ctrl+N → Zellij Resize mode
        "-workbench.action.files.save",                 // Ctrl+S → Zellij Scroll mode
        "-workbench.action.files.openFile",             // Ctrl+O → Zellij Session mode
        "-workbench.action.showAllSymbols",             // Ctrl+T → Zellij Tab mode
        "-editor.action.startFindReplaceAction",        // Ctrl+H → Zellij Move mode
        "-workbench.action.toggleSidebarVisibility",    // Ctrl+B → Zellij Tmux mode
        "-workbench.action.quit",                       // Ctrl+Q → Zellij Quit
        "-workbench.action.terminal.focusFind",         // Ctrl+F → Zellij page scroll
        "-editor.action.moveLinesUpAction",             // Alt+Up → Zellij focus up
        "-editor.action.moveLinesDownAction"            // Alt+Down → Zellij focus down
    ],
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4o-mini",
}